{
    "name": "todo-manager",
    "displayName": "TODO Manager",
    "description": "Find and navigate TODO comments in your workspace.",
    "version": "0.0.1",
    "scripts": {
        "compile": "tsc -p ./"
    },
    "main": "./out/extension.js",
    "engines": {
        "vscode": "^1.105.0"
    },
    "contributes": {
        "views": {
            "todo-manager": [
                {
                    "id": "todo-list",
                    "name": "List",
                    "icon": "resources/todo-manager.svg"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "todo-manager",
                    "title": "TODO manager",
                    "icon": "resources/todo-manager.svg"
                }
            ]
        },
        "commands": [
            {
                "command": "todo-manager.refresh",
                "title": "Refresh TODOs",
                "icon": {
                    "light": "resources/refresh_light.svg",
                    "dark": "resources/refresh_dark.svg"
                }
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "todo-manager.refresh",
                    "when": "view == todo-list",
                    "group": "navigation"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "todo-list",
                "contents": "Open a folder to view TODOs. Only sigle root workspaces are supported."
            }
        ]
    },
    "devDependencies": {
        "@types/vscode": "^1.138.0",
        "@types/node": "^26.6.2",
        "typescript": "^7.0.2"
    }
}